# Образец переменных для docker-compose: cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=timemanager
# Порт базы на хосте (внутри docker-сети всегда 5432)
DB_PORT=5435

# --- Приложение ЛР1 ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Порты сервисов на хосте ---
API_PORT=8000
PARSER_PORT=8001
REDIS_PORT=6380

# Образец конфигурации ЛР1. Скопируйте в .env и подставьте свои значения:
#   cp .env.example .env
#
# Файл .env в репозиторий не попадает — секреты хранятся только локально
# или передаются контейнеру через переменные окружения.

# Подключение к PostgreSQL (используется и приложением, и Alembic)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5435/timemanager

# Ключ подписи JWT. Сгенерировать новый:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Адрес сервиса-парсера (ЛР3)
PARSER_URL=http://localhost:8001
